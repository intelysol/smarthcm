# ==============================================================================
# ENTERPRISE APPLICATION PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE: Never commit production values or real secrets to git.
# All sensitive variables must be supplied via secrets managers (AWS Secrets Manager,
# HashiCorp Vault, Azure Key Vault, or Kubernetes Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
APP_NAME="Enterprise Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hcm.enterprise.internal
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Release Identification
APP_VERSION=2.65.0
APP_BUILD_ID=20260914.1
APP_RELEASE_DATE=2026-09-14

# ------------------------------------------------------------------------------
# 2. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_STDERR_FORMATTER=App\Support\Logging\StructuredJsonFormatter

# Sentry / APM Telemetry (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 3. DATABASE (MYSQL 8.4+ AUTHORITATIVE BASELINE)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smarthcm
DB_USERNAME=hcm_app_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT_MODE=true

# Read Replica Configuration (Optional)
# DB_READ_HOST=127.0.0.1
# DB_READ_PORT=3306

# ------------------------------------------------------------------------------
# 4. REDIS (HIGH-PERFORMANCE CACHING, SESSIONS & QUEUES)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis Database Allocation
REDIS_DB_SESSION=0
REDIS_DB_CACHE=1
REDIS_DB_QUEUE=2
REDIS_DB_REVERB=3

# ------------------------------------------------------------------------------
# 5. SESSION & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=hcm_cache_

# ------------------------------------------------------------------------------
# 6. QUEUE & HORIZON WORKERS
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
HORIZON_PREFIX=hcm_horizon:
HORIZON_BALANCE=auto
HORIZON_MIN_PROCESSES=3
HORIZON_MAX_PROCESSES=20

# ------------------------------------------------------------------------------
# 7. WEBSOCKETS (LARAVEL REVERB)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=enterprise_hcm_reverb
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

# ------------------------------------------------------------------------------
# 8. FILE STORAGE & OBJECT STORE
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=enterprise-hcm-documents-prod
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# ------------------------------------------------------------------------------
# 9. MAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@enterprise.internal"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 10. AUTHENTICATION & SECURITY GOVERNANCE
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
MFA_ENFORCE_ADMINS=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_CONCURRENT_LIMIT=3

# Health Check & Administration Access Token (Required for /health/ready deep probe)
HEALTH_CHECK_TOKEN=

# ------------------------------------------------------------------------------
# 11. AI GATEWAY & LLM PROVIDERS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_REQUEST_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 12. FRONTEND / VITE
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
